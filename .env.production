# Committed on purpose. Everything here is public and ends up in the shipped
# JavaScript anyway; secrets never belong in this file (use .env.local).
#
# Why a file and not the Pages dashboard: the root wrangler.toml makes that
# file the source of truth for the Pages project, and a variable set in the
# dashboard did not reach the build. Next.js reads .env.production during every
# `next build`, on Cloudflare or anywhere else, so this cannot silently drop.

# The multiplayer-cursor Durable Object in worker/.
NEXT_PUBLIC_CURSORS_URL=wss://portfolio-cursors.yulose9.workers.dev/cursors

# PostHog project API key (phc_, write-only, public by design — never a phx_
# personal key). Case-sensitive: a lowercased copy of this key is rejected by
# PostHog. Checked for format at build time in next.config.js.
NEXT_PUBLIC_POSTHOG_KEY=phc_JWsgoQ4GDwRswKSCOtTlD9LrW5C7aJ7wX5nyGqPBxXu

# Sentry DSN for error monitoring & performance tracing (public ingest endpoint)
NEXT_PUBLIC_SENTRY_DSN=https://7e01158ba3748889e0dfc1e8f00f95d4@o4512213284093952.ingest.us.sentry.io/4512213298184192

# Firebase web config for Seneca (admin ▸ Seneca). The API key is NOT kept in
# the repo: set NEXT_PUBLIC_FIREBASE_API_KEY in Cloudflare Pages (Settings >
# Variables, Production) using a browser key restricted to nazarene.dev and to
# the Firebase APIs only. The data is protected by the owner-only rules.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seneca-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seneca-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seneca-web.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=335958524686
NEXT_PUBLIC_FIREBASE_APP_ID=1:335958524686:web:6017a7f4bfaf513c808d5f

# Serve Firebase's sign-in helper from this domain (functions/__/[[path]].ts) so
# Safari and the iPhone home-screen app keep the sign-in. Needs the site's
# /__/auth/handler URLs in the Google OAuth client's redirect URIs (added).
NEXT_PUBLIC_FIREBASE_SAME_ORIGIN_AUTH=1
