# Committed on purpose. Everything here is public and ends up in the shipped
# JavaScript anyway; secrets never belong in this file (use .env.local).
#
# Why a file and not the Pages dashboard: the root wrangler.toml makes that
# file the source of truth for the Pages project, and a variable set in the
# dashboard did not reach the build. Next.js reads .env.production during every
# `next build`, on Cloudflare or anywhere else, so this cannot silently drop.

# The multiplayer-cursor Durable Object in worker/.
NEXT_PUBLIC_CURSORS_URL=wss://portfolio-cursors.yulose9.workers.dev/cursors
