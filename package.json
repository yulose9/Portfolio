{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Modern portfolio website built with Next.js, React, TypeScript, and Framer Motion",
  "author": "John Nazarene Dela Pisa",
  "license": "ISC",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:public": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start",
    "start:public": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint app lib --quiet",
    "images:optimize": "node scripts/optimize-images.mjs",
    "prebuild": "npm run images:optimize",
    "predev": "npm run images:optimize",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "predev:public": "npm run images:optimize",
    "preview": "node scripts/serve-static.mjs out 3000"
  },
  "keywords": [
    "portfolio",
    "nextjs",
    "react",
    "typescript",
    "framer-motion",
    "tailwindcss"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fluentui-emoji-js": "^1.2.1",
    "framer-motion": "^12.23.22",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "posthog-js": "^1.298.1",
    "posthog-node": "^5.14.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.6.1",
    "@types/react": "^19.1.16",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.6",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "wrangler": "^4.51.0"
  }
}
