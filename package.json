{
  "name": "portfolio",
  "version": "2.0.0",
  "description": "Portfolio website — Next.js, React, TypeScript, Tailwind CSS",
  "author": "John Nazarene Dela Pisa",
  "license": "ISC",
  "private": true,
  "scripts": {
    "sentry:off": "node scripts/manage-sentry.mjs off",
    "sentry:on": "node scripts/manage-sentry.mjs on",
    "sentry:remove": "node scripts/manage-sentry.mjs remove",
    "kumo:styles": "node scripts/prepare-kumo.mjs",
    "predev": "npm run kumo:styles",
    "prebuild": "npm run kumo:styles",
    "dev": "next dev --turbopack",
    "dev:public": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "node scripts/sync-fonts.mjs && next build",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "start": "next start",
    "lint": "eslint app --quiet",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p functions/tsconfig.json",
    "test": "node --loader ./tests/typescript-loader.mjs --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "keywords": [
    "portfolio",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss"
  ],
